#!/usr/bin/env bash
# Validates the commit message against Conventional Commits.
# Enable with: git config core.hooksPath .githooks
msg_file=$1
first=$(grep -v '^#' "$msg_file" | head -n1)

# Let git's own generated messages through.
case "$first" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

pattern='^(feat|fix|perf|refactor|docs|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^ ].{0,70}[^.]$'
if ! printf '%s' "$first" | grep -Eq "$pattern"; then
  cat >&2 <<MSG
Commit message does not follow Conventional Commits:

  $first

Expected:  <type>(<scope>): <summary>   (up to 72 chars, no trailing period)
Types:     feat fix perf refactor docs test build ci chore revert
Example:   fix(logs): keep follow mode after reconnect

See CONTRIBUTING.md.
MSG
  exit 1
fi
